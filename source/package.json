{
  "name": "convergence-card-game",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Editable source for the Convergence browser card game",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "publish:pages": "node scripts/publish-pages.mjs",
    "build:codex": "node scripts/build-codex.mjs",
    "preview": "vite preview",
    "validate:docs": "node scripts/validate-project-docs.mjs",
    "pretest": "npm run validate:docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx scripts/simulate.ts",
    "precheck:balance": "npm run validate:docs",
    "check:balance": "tsx scripts/simulate.ts --full",
    "check:audio": "node scripts/check-audio.mjs",
    "shoot": "node scripts/shoot-screens.mjs",
    "shoot:card": "node scripts/shoot-card.mjs",
    "validate:data": "npm run validate:docs && node scripts/validate-cards.mjs",
    "prebuild": "npm run validate:docs",
    "check:ui": "node scripts/check-ui.mjs",
    "check:cardface": "node scripts/check-cardface.mjs",
    "check:coverage": "node scripts/check-effect-coverage.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
